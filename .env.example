# Copy to .env (cp .env.example .env). Only DAHL_API_KEY is required for the default provider.
#
# LLM provider: dahl (default) | gemini | openrouter | anthropic | ollama
LLM_PROVIDER=dahl

# --- dahl (default): the Dahl inference API, OpenAI-compatible (https://inference.dahl.global/docs/api/) ---
# The key is a secret: keep it in .env only (git-ignored). Without it the chat answers with an error.
DAHL_API_KEY=
# Live models: curl https://inference.dahl.global/v1/models
# DAHL_MODEL=MiniMaxAI/MiniMax-M2.7
# DAHL_BASE_URL=https://inference.dahl.global/v1

# --- gemini: only with LLM_PROVIDER=gemini (OpenAI-compatible Gemini API, reads receipt photos) ---
# Key from https://aistudio.google.com/apikey (GOOGLE_API_KEY also works). Keep it in .env only.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- openrouter: only with LLM_PROVIDER=openrouter (one key, many models; vision models read receipt photos) ---
# Key from https://openrouter.ai/keys. Keep it in .env only.
# OPENROUTER_API_KEY=
# Models: curl https://openrouter.ai/api/v1/models (needs "tools"; "image" input for photos). Cheaper: google/gemini-2.5-flash
# OPENROUTER_MODEL=anthropic/claude-opus-5.5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- anthropic: only with LLM_PROVIDER=anthropic ---
# Credentials: by default the server uses the active `ant` CLI profile
# (brew install anthropics/tap/ant && ant auth login). Only uncomment the key
# below if you want to override the profile — an empty key shadows the profile.
# ANTHROPIC_API_KEY=
# Shared hackathon model (TZ §3: one model for all participants)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (fallbacks: "default"). "off" keeps every turn on the shared model.
# ANTHROPIC_FALLBACKS=default

# --- ollama: only with LLM_PROVIDER=ollama (see README, "Локальная модель через Ollama") ---
# OLLAMA_MODEL=qwen3.6:35b-a3b-q4_K_M
# OLLAMA_BASE_URL=http://localhost:11434

# debug | info | warn | error
LOG_LEVEL=debug

PORT=8787

# 1 = stream render_surface components to the client as they are generated (S10)
A2UI_STREAM=1
